{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "emberfallkeep",
  "compatibility_date": "2026-05-29",
  "observability": {
    "enabled": true
  },
  "main": "dist/_worker.js/index.js",
  "compatibility_flags": [
    "global_fetch_strictly_public",
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "dist",
    "run_worker_first": ["/characters/*", "/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "emberfallkeep-db",
      "database_id": "70aedfed-84af-477d-b1a6-5d7368ed9a1f",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "DISCORD_CLIENT_ID": "1535296931398557817",
    "DISCORD_REDIRECT_URI": "https://emberfallkeep.com/api/auth/discord/callback",
    "DM_DISCORD_IDS": "455879573113012227"
  }
}
