---
const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<nav class="nav">
  <a href="/" class="nav-brand">
    <svg
      class="monogram-nav"
      viewBox="0 0 60 44"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <text
        x="30"
        y="33"
        text-anchor="middle"
        font-family="Almendra SC, serif"
        font-size="28"
        font-weight="400"
        fill="currentColor"
      >EK</text>
    </svg>
    Emberfall Keep
  </a>
  <button
    type="button"
    class="nav-toggle"
    aria-expanded="false"
    aria-controls="nav-links"
    aria-label="Toggle navigation menu"
  >
    <i class="fa-solid fa-bars"></i>
  </button>
  <ul class="nav-links" id="nav-links">
    <li>
      <a href="/" class:list={[{ active: isActive('/') }]}>Campaign</a>
    </li>
    <li>
      <a href="/characters" class:list={[{ active: isActive('/characters') }]}>Fellowship</a>
    </li>
    <li>
      <a href="/sessions" class:list={[{ active: isActive('/sessions') }]}>Chronicles</a>
    </li>
    <li>
      <a href="/lore" class:list={[{ active: isActive('/lore') }]}>Compendium</a>
    </li>
    <li>
      <a href="/gamemasters" class:list={[{ active: isActive('/gamemasters') }]}>Gamemasters</a>
    </li>
    <li>
      <a href="/about" class:list={[{ active: isActive('/about') }]}>About</a>
    </li>
    <li>
      <a
        href="https://discord.gg/dTRaBUNY"
        target="_blank"
        rel="noopener"
        class="nav-discord"
      ><i class="fa-brands fa-discord"></i> Discord</a>
    </li>
    <li id="nav-auth-slot"></li>
  </ul>
</nav>

<script>
  // Prerendered pages never run the Worker/middleware, so we can't read
  // Astro.locals.player here — fall back to the non-HttpOnly `pd` cookie
  // (display-only, set alongside the real session cookie on login).
  const pd = document.cookie
    .split('; ')
    .find((c) => c.startsWith('pd='))
    ?.split('=')[1];
  const slot = document.getElementById('nav-auth-slot');
  if (slot) {
    slot.innerHTML = pd
      ? `<span class="nav-player">${decodeURIComponent(pd)}</span> <a href="/api/auth/discord/logout" class="nav-logout">Logout</a>`
      : `<a href="/api/auth/discord/login" class="nav-logout">Login with Discord</a>`;
  }

  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const links = document.getElementById('nav-links');
  const toggleIcon = toggle?.querySelector('i');

  const closeMenu = () => {
    if (!toggle || !links) return;
    toggle.setAttribute('aria-expanded', 'false');
    links.classList.remove('open');
    toggleIcon?.classList.replace('fa-xmark', 'fa-bars');
  };

  const openMenu = () => {
    if (!toggle || !links) return;
    toggle.setAttribute('aria-expanded', 'true');
    links.classList.add('open');
    toggleIcon?.classList.replace('fa-bars', 'fa-xmark');
  };

  toggle?.addEventListener('click', () => {
    const isOpen = links?.classList.contains('open');
    isOpen ? closeMenu() : openMenu();
  });

  links?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).tagName === 'A') closeMenu();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMenu();
  });

  document.addEventListener('click', (e) => {
    if (!links?.classList.contains('open')) return;
    if (links.contains(e.target as Node) || toggle?.contains(e.target as Node)) return;
    closeMenu();
  });
</script>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 2.5rem;
    height: 52px;
    background: rgba(39, 37, 36, 0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid rgba(74, 72, 69, 0.5);
  }

  .nav-brand {
    font-family: "Cinzel", serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--mist-mid);
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .monogram-nav {
    width: 30px;
    height: 30px;
    color: var(--teal-mid);
    flex-shrink: 0;
  }

  .nav-toggle {
    display: none;
    background: none;
    border: none;
    color: var(--mist-mid);
    font-size: 20px;
    padding: 0.4rem;
    cursor: pointer;
    line-height: 1;
  }

  .nav-toggle:hover {
    color: var(--mist-bright);
  }

  .nav-links {
    display: flex;
    flex-shrink: 0;
    gap: 0;
    list-style: none;
  }

  .nav-links a {
    font-family: "Cinzel", serif;
    font-size: 10px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--text-dim);
    padding: 0.4rem 0.9rem;
    text-decoration: none;
    transition: color 0.2s;
    display: block;
    white-space: nowrap;
  }

  .nav-links a:hover,
  .nav-links a.active {
    color: var(--mist-bright);
  }

  /* Injected client-side via innerHTML in the <script> below, so these
     can't rely on Astro's build-time scoped CSS — :global() bypasses that. */
  :global(.nav-player) {
    font-family: "Cinzel", serif;
    font-size: 10px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--text-dim);
    padding: 0.4rem 0 0.4rem 0.9rem;
    max-width: 160px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    display: inline-block;
    vertical-align: middle;
  }

  :global(.nav-logout) {
    font-family: "Cinzel", serif;
    font-size: 10px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--text-dim);
    padding: 0.4rem 0.9rem;
    text-decoration: none;
    transition: color 0.2s;
  }

  :global(.nav-logout:hover) {
    color: var(--mist-bright);
  }

  .nav-discord {
    color: #7289da !important;
  }

  .nav-discord:hover {
    color: #99aaf0 !important;
  }

  @media (max-width: 1220px) {
    .nav-toggle {
      display: block;
    }

    .nav-links {
      position: fixed;
      top: var(--nav-height, 52px);
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      max-height: calc(100vh - var(--nav-height, 52px));
      overflow-y: auto;
      background: rgba(39, 37, 36, 0.97);
      backdrop-filter: blur(8px);
      border-bottom: 1px solid rgba(74, 72, 69, 0.5);
      transform: translateY(-100%);
      opacity: 0;
      visibility: hidden;
      transition: transform 0.25s ease, opacity 0.25s ease, visibility 0.25s;
    }

    .nav-links.open {
      transform: translateY(0);
      opacity: 1;
      visibility: visible;
    }

    .nav-links li {
      width: 100%;
    }

    .nav-links a {
      padding: 0.9rem 2.5rem;
      font-size: 12px;
      border-bottom: 1px solid rgba(74, 72, 69, 0.3);
    }

    :global(.nav-player),
    :global(.nav-logout) {
      display: block;
      padding: 0.9rem 2.5rem;
      font-size: 12px;
    }
  }
</style>
