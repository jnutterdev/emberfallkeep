---
import Base from '../../../layouts/Base.astro';
import PageHeader from '../../../components/PageHeader.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const factions = await getCollection('factions');
  return factions.map(f => ({
    params: { slug: f.slug },
    props: { faction: f },
  }));
}

const { faction } = Astro.props;
const { Content } = await render(faction);
---

<Base title={faction.data.name} description={faction.data.description}>
  <PageHeader
    title={faction.data.name}
    subtitle={faction.data.motto}
    backHref="/lore"
    backLabel="Compendium"
  />
  <main class="main">
    <div class="wrap">
      <div class="detail-layout">
        <article class="prose">
          {faction.data.description && <p class="lead">{faction.data.description}</p>}
          <Content />
        </article>
        <aside class="sidebar">
          <div class="sidebar-block">
            <h3 class="sidebar-heading">Details</h3>
            <p class="detail-row"><span>Type</span><strong>{faction.data.type}</strong></p>
            <p class="detail-row"><span>Relationship</span><strong>{faction.data.partyRelationship}</strong></p>
            {faction.data.alignment && <p class="detail-row"><span>Alignment</span><strong>{faction.data.alignment}</strong></p>}
            {faction.data.headquarters && <p class="detail-row"><span>Headquarters</span><strong>{faction.data.headquarters}</strong></p>}
          </div>
          {faction.data.notableMembers.length > 0 && (
            <div class="sidebar-block">
              <h3 class="sidebar-heading">Notable Members</h3>
              <ul class="member-list">
                {faction.data.notableMembers.map(m => <li>{m}</li>)}
              </ul>
            </div>
          )}
        </aside>
      </div>
    </div>
  </main>
</Base>

<style>
  .main { padding: 3.5rem 0 5rem; }
  .detail-layout {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 3rem;
    align-items: start;
  }
  .prose {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 16px; line-height: 1.8;
    color: var(--text-body);
  }
  .prose :global(p) { margin-bottom: 1.25rem; }
  .lead { font-size: 18px; color: var(--text-muted); font-style: italic; }
  .sidebar { position: sticky; top: calc(var(--nav-height) + 2rem); }
  .sidebar-block {
    background: var(--void-surface);
    border: 1px solid var(--border-default);
    padding: 1.25rem;
    margin-bottom: 1rem;
  }
  .sidebar-heading {
    font-family: "Cinzel", serif; font-size: 9px;
    letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--text-dim); margin-bottom: 0.75rem;
    padding-bottom: 0.5rem; border-bottom: 1px solid var(--border-default);
  }
  .detail-row {
    display: flex; justify-content: space-between; align-items: baseline;
    gap: 1rem; padding: 0.35rem 0;
    border-bottom: 1px solid rgba(74,72,69,0.4);
    font-size: 13px;
  }
  .detail-row:last-child { border-bottom: none; }
  .detail-row span {
    font-family: "Cinzel", serif; font-size: 9px;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-dim);
  }
  .detail-row strong { color: var(--mist-mid); font-weight: 500; text-align: right; }
  .member-list { list-style: none; font-size: 14px; color: var(--text-muted); }
  .member-list li { padding: 0.25rem 0; border-bottom: 1px solid rgba(74,72,69,0.4); }
  .member-list li:last-child { border-bottom: none; }
  @media (max-width: 800px) {
    .detail-layout { grid-template-columns: 1fr; }
    .sidebar { position: static; }
  }
</style>
