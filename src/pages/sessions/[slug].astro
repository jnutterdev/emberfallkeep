---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const sessions = await getCollection('sessions');
  return sessions.map(s => ({
    params: { slug: s.slug },
    props: { session: s },
  }));
}

const { session } = Astro.props;
const { Content } = await render(session);

// Load characters so we can resolve TinaCMS reference paths to display names.
// New format:    { character: "src/content/characters/thessira-vael.md" }
// Legacy format: "src/content/characters/thessira-vael.md"  (plain reference path)
// Oldest format: "Thessira Vael"  (plain string, before the reference field existed)
const allCharacters = await getCollection('characters');

function resolvePartyMember(ref: string | { character: string }): string {
  // Unwrap the new object format
  const path = typeof ref === 'object' && ref !== null ? ref.character : ref;
  // If it looks like a file path, extract the slug and look up the character name
  if (path.includes('/')) {
    const slugLower = path.split('/').pop()?.replace(/\.mdx?$/, '').toLowerCase() ?? path;
    // Case-insensitive match — Astro v5 lowercases slugs but stored
    // reference paths may preserve the original filename casing.
    const match = allCharacters.find(c => c.slug.toLowerCase() === slugLower);
    if (match) return match.data.name;
    // Slug not found — humanise the filename as a readable fallback
    return slugLower.replace(/-/g, ' ').replace(/\b\w/g, (l: string) => l.toUpperCase());
  }
  // Already a plain display string (oldest legacy data)
  return path;
}

const dateStr = session.data.date.toLocaleDateString('en-GB', {
  day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
});

const partyPresentNames = session.data.partyPresent
  .map(resolvePartyMember)
  .sort((a, b) => a.localeCompare(b));

const allSessions = (await getCollection('sessions'))
  .sort((a, b) => a.data.sessionNumber - b.data.sessionNumber);
const currentIndex = allSessions.findIndex(s => s.slug === session.slug);
const prevSession = currentIndex > 0 ? allSessions[currentIndex - 1] : null;
const nextSession = currentIndex < allSessions.length - 1 ? allSessions[currentIndex + 1] : null;

function stripTitlePrefix(title: string): string {
  const idx = title.indexOf('—');
  return idx !== -1 ? title.slice(idx + 1).trim() : title;
}
---

<Base title={session.data.title}>
  <PageHeader
    title={session.data.title}
    subtitle={`Session ${session.data.sessionNumber} · ${dateStr}`}
    backHref="/sessions"
    backLabel="All Chronicles"
  />
  <main class="main">
    <div class="wrap">
      <div class="podcast-bar">
        <div class="podcast-icon"><i class="fa-solid fa-podcast"></i></div>
        <div class="podcast-body">
          <span class="podcast-label">Deep Dive Podcast</span>
          {session.data.podcastUrl ? (
            <div class="pp">
              <button type="button" class="pp-toggle" aria-label="Play episode">
                <i class="fa-solid fa-play"></i>
              </button>
              <span class="pp-time pp-current">0:00</span>
              <input type="range" class="pp-scrubber" min="0" max="0" value="0" step="0.1" aria-label="Seek" />
              <span class="pp-time pp-duration">0:00</span>
              <audio class="pp-audio" preload="metadata" src={session.data.podcastUrl}>
                Your browser doesn't support inline audio — <a href={session.data.podcastUrl}>download the episode</a> instead.
              </audio>
            </div>
          ) : (
            <span class="podcast-placeholder">Coming soon</span>
          )}
        </div>
      </div>
      <div class="session-layout">
        <article class="prose">
          <Content />
        </article>
        <aside class="sidebar">
          {partyPresentNames.length > 0 && (
            <div class="sidebar-block">
              <h3 class="sidebar-heading">Party Present</h3>
              <ul class="party-list">
                {partyPresentNames.map((name: string) => (
                  <li><i class="fa-solid fa-user"></i> {name}</li>
                ))}
              </ul>
            </div>
          )}
          {session.data.rewards && (
            <div class="sidebar-block">
              <h3 class="sidebar-heading">Rewards</h3>
              {session.data.rewards.xp && <p class="reward-row"><span>XP</span><strong>{session.data.rewards.xp.toLocaleString()}</strong></p>}
              {session.data.rewards.gold && <p class="reward-row"><span>Gold</span><strong>{session.data.rewards.gold} gp</strong></p>}
              {session.data.rewards.loot && session.data.rewards.loot.length > 0 && (
                <>
                  <p class="sidebar-subhead">Loot</p>
                  <ul class="loot-list">
                    {session.data.rewards.loot.map(item => <li>{item}</li>)}
                  </ul>
                </>
              )}
            </div>
          )}
        </aside>
      </div>

      <nav class="session-nav">
        {prevSession ? (
          <a href={`/sessions/${prevSession.slug}`} class="session-nav-link session-nav-prev">
            <i class="fa-solid fa-chevron-left"></i>
            <span class="session-nav-text">
              <span class="session-nav-label">Previous</span>
              <span class="session-nav-title">{stripTitlePrefix(prevSession.data.title)}</span>
            </span>
          </a>
        ) : <span class="session-nav-spacer" />}
        {nextSession ? (
          <a href={`/sessions/${nextSession.slug}`} class="session-nav-link session-nav-next">
            <span class="session-nav-text">
              <span class="session-nav-label">Next</span>
              <span class="session-nav-title">{stripTitlePrefix(nextSession.data.title)}</span>
            </span>
            <i class="fa-solid fa-chevron-right"></i>
          </a>
        ) : <span class="session-nav-spacer" />}
      </nav>
    </div>
  </main>
</Base>

<style>
  .main { padding: 3.5rem 0 5rem; }

  /* ── Podcast Bar ─────────────────────────────────────────────────── */
  .podcast-bar {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    background: var(--void-surface);
    border: 1px solid var(--border-default);
    border-left: 2px solid var(--teal-deep);
    border-radius: 2px;
    padding: 1.1rem 1.4rem;
    margin-bottom: 2.5rem;
  }
  .podcast-icon {
    width: 40px; height: 40px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    background: var(--void-raised);
    border: 1px solid var(--border-default);
    border-radius: 50%;
    color: var(--teal-mid); font-size: 15px;
  }
  .podcast-body {
    display: flex; flex-wrap: wrap;
    align-items: center; gap: 0.4rem 1.25rem;
    flex: 1; min-width: 0;
  }
  .podcast-label {
    font-family: "Cinzel", serif; font-size: 9px;
    letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--text-dim); flex-shrink: 0;
  }
  .podcast-placeholder {
    font-style: italic; font-size: 14px; color: var(--text-dim);
  }

  /* Custom player — native <audio controls> renders wildly differently
     per platform (iOS Safari/Chrome collapse to a bare play button with
     no scrubber, no CSS fix possible), so we drive a hidden <audio>
     element with our own UI instead. */
  .pp {
    display: flex; align-items: center; gap: 0.9rem;
    flex: 1; min-width: 240px; max-width: 100%;
  }
  .pp-toggle {
    flex-shrink: 0; width: 32px; height: 32px;
    display: flex; align-items: center; justify-content: center;
    background: var(--void-raised);
    border: 1px solid var(--border-accent);
    border-radius: 50%;
    color: var(--teal-bright);
    font-size: 12px;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s;
  }
  .pp-toggle:hover {
    background: rgba(104,152,168,0.12);
    border-color: var(--teal-mid);
  }
  .pp-toggle .fa-play { margin-left: 2px; }
  .pp-time {
    font-family: monospace; font-size: 11px;
    color: var(--text-dim); flex-shrink: 0;
    min-width: 32px;
  }
  .pp-time.pp-current { text-align: right; }
  .pp-scrubber {
    -webkit-appearance: none;
    appearance: none;
    flex: 1; min-width: 0;
    height: 4px;
    border-radius: 2px;
    background: linear-gradient(to right,
      var(--teal-mid) 0%, var(--teal-mid) var(--pp-progress, 0%),
      var(--void-raised) var(--pp-progress, 0%), var(--void-raised) 100%);
    outline: none;
    cursor: pointer;
  }
  .pp-scrubber::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 12px; height: 12px; border-radius: 50%;
    background: var(--mist-bright);
    cursor: pointer;
  }
  .pp-scrubber::-moz-range-thumb {
    width: 12px; height: 12px; border-radius: 50%;
    background: var(--mist-bright); border: none; cursor: pointer;
  }
  .pp-scrubber::-moz-range-track {
    height: 4px; border-radius: 2px; background: var(--void-raised);
  }
  .pp-scrubber::-moz-range-progress {
    height: 4px; border-radius: 2px; background: var(--teal-mid);
  }
  .pp-audio { display: none; }
  @media (max-width: 500px) {
    .podcast-bar { flex-direction: column; align-items: flex-start; }
    .pp { width: 100%; }
  }

  .session-layout {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 3rem;
    align-items: start;
  }
  /* Prose */
  .prose {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 16px; line-height: 1.8;
    color: var(--text-body);
  }
  .prose :global(p) { margin-bottom: 1.25rem; }
  .prose :global(p:first-child) { font-size: 18px; color: var(--text-muted); }
  .prose :global(h2) {
    font-family: "Cinzel Decorative", serif; font-size: 20px;
    color: var(--mist-bright); margin: 2.5rem 0 1rem;
    padding-bottom: 0.5rem; border-bottom: 1px solid var(--border-default);
    clear: both;
  }
  .prose :global(h3) {
    font-family: "Cinzel", serif; font-size: 14px; font-weight: 600;
    letter-spacing: 0.06em; color: var(--mist-mid);
    margin: 2rem 0 0.75rem; text-transform: uppercase;
    clear: both;
  }

  /* Images dropped inline in the recap markdown auto-alternate left/right
     (see script below) so text wraps around them. Capping max-width AND
     max-height (with width/height left auto) lets both portrait and
     landscape images shrink to fit while keeping their own aspect ratio. */
  .prose :global(img) {
    border: 1px solid var(--border-default);
    display: block;
  }
  .prose :global(img.float-left),
  .prose :global(img.float-right) {
    max-width: 42%;
    max-height: 380px;
    width: auto;
    height: auto;
  }
  .prose :global(img.float-left) {
    float: left;
    margin: 0.3rem 1.5rem 1rem 0;
  }
  .prose :global(img.float-right) {
    float: right;
    margin: 0.3rem 0 1rem 1.5rem;
  }
  @media (max-width: 700px) {
    .prose :global(img.float-left),
    .prose :global(img.float-right) {
      float: none;
      max-width: 100%;
      max-height: none;
      margin: 1rem 0;
    }
  }
  /* Sidebar */
  .sidebar { position: sticky; top: calc(var(--nav-height) + 2rem); }
  .sidebar-block {
    background: var(--void-surface);
    border: 1px solid var(--border-default);
    padding: 1.25rem;
    margin-bottom: 1rem;
  }
  .sidebar-heading {
    font-family: "Cinzel", serif; font-size: 9px;
    letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--text-dim); margin-bottom: 0.75rem;
    padding-bottom: 0.5rem; border-bottom: 1px solid var(--border-default);
  }
  .sidebar-subhead {
    font-family: "Cinzel", serif; font-size: 8px;
    letter-spacing: 0.15em; text-transform: uppercase;
    color: var(--text-dim); margin: 0.75rem 0 0.4rem;
  }
  .party-list, .loot-list {
    list-style: none; font-size: 14px; color: var(--text-muted);
  }
  .party-list li { margin-bottom: 0.3rem; }
  .party-list i { color: var(--teal-mid); margin-right: 0.4rem; font-size: 11px; }
  .loot-list li { padding: 0.2rem 0; border-bottom: 1px solid var(--border-default); font-size: 14px; }
  .loot-list li:last-child { border-bottom: none; }
  .reward-row {
    display: flex; justify-content: space-between;
    font-family: "Cinzel", serif; font-size: 10px;
    letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--text-dim); margin-bottom: 0.4rem;
  }
  .reward-row strong { color: var(--mist-mid); font-family: "Cinzel Decorative", serif; font-size: 14px; text-transform: none; letter-spacing: 0; }

  /* ── Session Nav (prev/next) ─────────────────────────────────────── */
  .session-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-default);
  }
  .session-nav-link {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 1rem 1.25rem;
    background: var(--void-surface);
    border: 1px solid var(--border-default);
    border-radius: 2px;
    text-decoration: none;
    transition: background 0.15s, border-color 0.15s;
  }
  .session-nav-link:hover {
    background: var(--void-raised);
    border-color: var(--border-mist);
  }
  .session-nav-link:hover .session-nav-title { color: var(--mist-bright); }
  .session-nav-link i {
    flex-shrink: 0;
    color: var(--teal-mid);
    font-size: 14px;
    transition: color 0.15s;
  }
  .session-nav-link:hover i { color: var(--teal-bright); }
  .session-nav-next { grid-column: 2; justify-self: end; }
  .session-nav-next .session-nav-text { text-align: right; }
  .session-nav-text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }
  .session-nav-label {
    font-family: "Cinzel", serif; font-size: 8px;
    letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--text-dim);
  }
  .session-nav-title {
    font-family: "Cinzel", serif; font-size: 13px; font-weight: 600;
    letter-spacing: 0.03em; color: var(--mist-mid);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    transition: color 0.2s;
  }
  .session-nav-spacer { grid-column: auto; }

  @media (max-width: 800px) {
    .session-layout { grid-template-columns: 1fr; }
    .sidebar { position: static; }
  }
  @media (max-width: 560px) {
    .session-nav { grid-template-columns: 1fr; }
    .session-nav-next {
      grid-column: 1;
      justify-self: stretch;
      flex-direction: row-reverse;
    }
    .session-nav-next .session-nav-text { text-align: left; }
  }
</style>

<script>
  // Images dropped inline in the recap markdown alternate left/right in
  // document order, so authors just write plain ![alt](src) — no need to
  // track which side is next.
  document.querySelectorAll('.prose img').forEach((img, i) => {
    img.classList.add(i % 2 === 0 ? 'float-left' : 'float-right');
  });

  function fmtTime(seconds: number): string {
    if (!Number.isFinite(seconds)) return '0:00';
    const m = Math.floor(seconds / 60);
    const s = Math.floor(seconds % 60);
    return `${m}:${String(s).padStart(2, '0')}`;
  }

  document.querySelectorAll<HTMLDivElement>('.pp').forEach((player) => {
    const audio = player.querySelector<HTMLAudioElement>('.pp-audio');
    const toggle = player.querySelector<HTMLButtonElement>('.pp-toggle');
    const icon = toggle?.querySelector('i');
    const scrubber = player.querySelector<HTMLInputElement>('.pp-scrubber');
    const currentEl = player.querySelector<HTMLSpanElement>('.pp-current');
    const durationEl = player.querySelector<HTMLSpanElement>('.pp-duration');
    if (!audio || !toggle || !icon || !scrubber || !currentEl || !durationEl) return;

    const setProgress = (current: number, duration: number) => {
      const pct = duration > 0 ? (current / duration) * 100 : 0;
      scrubber.style.setProperty('--pp-progress', `${pct}%`);
    };

    toggle.addEventListener('click', () => {
      if (audio.paused) audio.play();
      else audio.pause();
    });

    audio.addEventListener('play', () => {
      icon.classList.replace('fa-play', 'fa-pause');
      toggle.setAttribute('aria-label', 'Pause episode');
    });

    audio.addEventListener('pause', () => {
      icon.classList.replace('fa-pause', 'fa-play');
      toggle.setAttribute('aria-label', 'Play episode');
    });

    audio.addEventListener('loadedmetadata', () => {
      scrubber.max = String(audio.duration);
      durationEl.textContent = fmtTime(audio.duration);
    });

    audio.addEventListener('timeupdate', () => {
      if (document.activeElement !== scrubber) {
        scrubber.value = String(audio.currentTime);
      }
      currentEl.textContent = fmtTime(audio.currentTime);
      setProgress(audio.currentTime, audio.duration);
    });

    audio.addEventListener('ended', () => {
      icon.classList.replace('fa-pause', 'fa-play');
      toggle.setAttribute('aria-label', 'Play episode');
    });

    scrubber.addEventListener('input', () => {
      const value = scrubber.valueAsNumber;
      audio.currentTime = value;
      currentEl.textContent = fmtTime(value);
      setProgress(value, audio.duration);
    });
  });
</script>
