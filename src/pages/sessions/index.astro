---
export const prerender = false;

import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { isDmForAnyCampaign } from '../../lib/permissions';

const allSessions = (await getCollection('sessions'))
  .sort((a, b) => b.data.sessionNumber - a.data.sessionNumber);

const isDM = isDmForAnyCampaign(Astro.locals.runtime.env.DM_DISCORD_IDS, Astro.locals.player?.discordId);

const latest = allSessions[0];
const oldest = allSessions[allSessions.length - 1];

const totalXP = allSessions.reduce((sum, s) => sum + (s.data.rewards?.xp ?? 0), 0);

function toRoman(num: number): string {
  if (!num || num <= 0) return '–';
  const vals = [1000,900,500,400,100,90,50,40,10,9,5,4,1];
  const syms = ['M','CM','D','CD','C','XC','L','XL','X','IX','V','IV','I'];
  let result = '';
  for (let i = 0; i < vals.length; i++) {
    while (num >= vals[i]) { result += syms[i]; num -= vals[i]; }
  }
  return result;
}

function fmtDate(d?: Date): string {
  if (!d) return '—';
  return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
}

function stripPrefix(title: string): string {
  const idx = title.indexOf('—');
  return idx !== -1 ? title.slice(idx + 1).trim() : title;
}
---

<Base title="Chronicles" description="A record of every session, in the order they were lived.">

  <!-- ── PAGE HEADER ─────────────────────────────────────────────────────── -->
  <header class="page-header">
    <div class="page-header-inner">
      <div class="page-header-left">
        <a href="/" class="page-back">
          <i class="fa-solid fa-chevron-left"></i> Emberfall Keep
        </a>
        <h1 class="page-title">Chronicles</h1>
        <p class="page-subtitle">A record of every session, in the order they were lived.</p>
      </div>
      {isDM && (
        <div class="page-header-right">
          <a href="/admin/index.html#/chronicles/new" class="btn btn-ghost"><i class="fa-solid fa-scroll"></i> New Entry</a>
        </div>
      )}
    </div>

    <!-- Stat strip -->
    <div class="stat-strip">
      <div class="stat-strip-inner">
        <div class="strip-stat">
          <span class="lbl">Sessions</span>
          <span class="val">{allSessions.length}</span>
        </div>
        <div class="strip-stat">
          <span class="lbl">Total XP</span>
          <span class="val">{totalXP > 0 ? totalXP.toLocaleString() : '—'}</span>
        </div>
        <div class="strip-stat">
          <span class="lbl">First Session</span>
          <span class="val">{oldest ? fmtDate(oldest.data.date) : '—'}</span>
        </div>
        <div class="strip-stat">
          <span class="lbl">Last Session</span>
          <span class="val">{latest ? fmtDate(latest.data.date) : '—'}</span>
        </div>
        <div class="strip-stat">
          <span class="lbl">Party Members</span>
          <span class="val">{latest?.data.partyPresent?.length ?? '—'}</span>
        </div>
      </div>
    </div>
  </header>

  <!-- ── MAIN ────────────────────────────────────────────────────────────── -->
  <main class="main">
    <div class="wrap">
      <div class="chronicles-layout">
        <!-- Session list -->
        <div class="session-list-col">
            {allSessions.length > 0 ? (
              <ul class="session-list">
                {allSessions.map((s, i) => (
                  <li>
                    <a
                      href={`/sessions/${s.slug}`}
                      class:list={['session-entry', { latest: i === 0 }]}
                    >
                      <div class="se-num-col">
                        <span class="se-num">{toRoman(s.data.sessionNumber)}</span>
                        <span class="se-num-label">Session</span>
                      </div>
                      <div class="se-body">
                        <div class="se-header">
                          <span class="se-title-group">
                            <span class="se-title">{stripPrefix(s.data.title)}</span>
                            {i === 0 && <span class="se-tag highlight">Latest</span>}
                          </span>
                          <span class="se-date">{fmtDate(s.data.date)}</span>
                        </div>
                        {s.data.summary && (
                          <p class="se-desc">{s.data.summary}</p>
                        )}
                        {s.data.rewards?.xp && (
                          <div class="se-footer">
                            <span class="se-meta">
                              {s.data.rewards.xp.toLocaleString()} XP
                              {s.data.partyPresent?.length
                                ? <>&nbsp;&middot;&nbsp;{s.data.partyPresent.length} present</>
                                : ''}
                            </span>
                          </div>
                        )}
                      </div>
                    </a>
                  </li>
                ))}
              </ul>
            ) : (
              <div class="empty-state">
                <i class="fa-solid fa-book-open"></i>
                <p>The chronicles are empty. Your story has yet to be written.</p>
              </div>
            )}
        </div>

        <!-- Podcast playlist -->
        <aside class="podcast-sidebar">
          <div class="ps-header">
            <i class="fa-solid fa-podcast"></i>
            <span>Deep Dive Podcast</span>
          </div>

          {allSessions.some(s => s.data.podcastUrl) ? (
            <>
              <div class="pp" id="playlist-player">
                <button type="button" class="pp-toggle" aria-label="Play episode" disabled>
                  <i class="fa-solid fa-play"></i>
                </button>
                <span class="pp-time pp-current">0:00</span>
                <input type="range" class="pp-scrubber" min="0" max="0" value="0" step="0.1" aria-label="Seek" />
                <span class="pp-time pp-duration">0:00</span>
                <audio class="pp-audio" preload="none"></audio>
              </div>
              <p class="ps-now-playing" id="ps-now-playing">Select an episode to play</p>

              <ul class="ps-list">
                {allSessions.filter(s => s.data.podcastUrl).map(s => (
                  <li>
                    <button
                      type="button"
                      class="ps-item"
                      data-src={s.data.podcastUrl}
                      data-title={stripPrefix(s.data.title)}
                    >
                      <span class="ps-num">{toRoman(s.data.sessionNumber)}</span>
                      <span class="ps-title">{stripPrefix(s.data.title)}</span>
                      <i class="fa-solid fa-play ps-play-icon"></i>
                    </button>
                  </li>
                ))}
              </ul>
            </>
          ) : (
            <p class="ps-empty">No episodes yet.</p>
          )}
        </aside>
      </div>
    </div>
  </main>

</Base>

<style>
  /* ── Page Header ──────────────────────────────────────────────────── */
  .page-header {
    margin-top: 52px;
    padding: 4rem 0 0;
    border-bottom: 1px solid var(--border-default);
    background: linear-gradient(180deg, rgba(180,100,80,0.05) 0%, transparent 100%);
  }
  .page-header-inner {
    max-width: 1100px; margin: 0 auto; padding: 0 2.5rem 2.5rem;
    display: flex; align-items: flex-end; justify-content: space-between; gap: 2rem;
  }
  .page-back {
    display: inline-flex; align-items: center; gap: 0.5rem;
    font-family: "Cinzel", serif; font-size: 9px;
    letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--text-dim); text-decoration: none;
    margin-bottom: 1rem; transition: color 0.2s; display: block;
  }
  .page-back:hover { color: var(--mist-mid); }
  .page-title {
    font-family: "Cinzel Decorative", serif;
    font-size: clamp(32px, 5vw, 56px);
    font-weight: 700; color: var(--mist-bright);
    line-height: 1; margin-bottom: 0.5rem;
  }
  .page-subtitle {
    font-family: "Cinzel", serif; font-size: 14px;
    letter-spacing: 0.08em; color: var(--text-muted);
  }
  .page-header-right {
    display: flex; flex-direction: column;
    align-items: flex-end; gap: 0.75rem; padding-bottom: 0.25rem;
  }

  /* ── Stat Strip ───────────────────────────────────────────────────── */
  .stat-strip {
    border-top: 1px solid var(--border-default);
    background: var(--void-surface);
  }
  .stat-strip-inner {
    max-width: 1100px; margin: 0 auto;
    padding: 0 2.5rem; display: flex;
  }
  .strip-stat {
    flex: 1; padding: 0.9rem 1.25rem;
    border-right: 1px solid var(--border-default);
    text-align: center;
  }
  .strip-stat:last-child { border-right: none; }
  .strip-stat .lbl {
    font-family: "Cinzel", serif; font-size: 8px;
    letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--text-dim); display: block; margin-bottom: 0.2rem;
  }
  .strip-stat .val {
    font-family: monospace; font-size: 15px; color: var(--teal-mid);
  }

  /* ── Main Layout ──────────────────────────────────────────────────── */
  .main { padding: 3.5rem 0 5rem; }
  .chronicles-layout {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 3rem;
    align-items: start;
  }
  .session-list-col { max-width: 760px; }

  /* ── Podcast Playlist Sidebar ────────────────────────────────────── */
  .podcast-sidebar {
    position: sticky;
    top: calc(var(--nav-height, 52px) + 2rem);
    background: var(--void-surface);
    border: 1px solid var(--border-default);
    border-left: 2px solid var(--teal-deep);
    border-radius: 2px;
    padding: 1.25rem;
  }
  .ps-header {
    display: flex; align-items: center; gap: 0.5rem;
    font-family: "Cinzel", serif; font-size: 9px;
    letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--text-dim); margin-bottom: 1rem;
  }
  .ps-header i { color: var(--teal-mid); font-size: 12px; }
  .ps-now-playing {
    font-style: italic; font-size: 12px;
    color: var(--text-dim); margin: 0.6rem 0 1rem;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .ps-now-playing.playing { color: var(--teal-mid); font-style: normal; }
  .ps-empty {
    font-style: italic; font-size: 13px; color: var(--text-dim);
  }

  .ps-list { list-style: none; display: flex; flex-direction: column; gap: 2px; }
  .ps-item {
    display: flex; align-items: center; gap: 0.6rem;
    width: 100%; padding: 0.55rem 0.6rem;
    background: none; border: none; border-radius: 2px;
    cursor: pointer; text-align: left;
    transition: background 0.15s;
  }
  .ps-item:hover { background: var(--void-raised); }
  .ps-item.active { background: rgba(104,152,168,0.1); }
  .ps-num {
    font-family: "Cinzel Decorative", serif; font-size: 13px;
    color: var(--teal-deep); flex-shrink: 0; width: 1.5rem;
  }
  .ps-item.active .ps-num { color: var(--teal-bright); }
  .ps-title {
    flex: 1; min-width: 0;
    font-family: "Cinzel", serif; font-size: 11px; letter-spacing: 0.02em;
    color: var(--text-muted);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .ps-item.active .ps-title { color: var(--mist-bright); }
  .ps-play-icon {
    flex-shrink: 0; font-size: 9px; color: var(--text-dim);
    opacity: 0; transition: opacity 0.15s;
  }
  .ps-item:hover .ps-play-icon,
  .ps-item.active .ps-play-icon { opacity: 1; color: var(--teal-mid); }
  .ps-item.active .ps-play-icon.fa-pause { color: var(--teal-bright); }

  /* Custom player — same pattern as the session detail page (native
     <audio controls> renders inconsistently across platforms). */
  .pp {
    display: flex; align-items: center; gap: 0.6rem;
    margin-bottom: 0.5rem;
  }
  .pp-toggle {
    flex-shrink: 0; width: 32px; height: 32px;
    display: flex; align-items: center; justify-content: center;
    background: var(--void-raised);
    border: 1px solid var(--border-accent);
    border-radius: 50%;
    color: var(--teal-bright);
    font-size: 12px;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s;
  }
  .pp-toggle:hover:not(:disabled) {
    background: rgba(104,152,168,0.12);
    border-color: var(--teal-mid);
  }
  .pp-toggle:disabled { opacity: 0.4; cursor: default; }
  .pp-toggle .fa-play { margin-left: 2px; }
  .pp-time {
    font-family: monospace; font-size: 10px;
    color: var(--text-dim); flex-shrink: 0;
    min-width: 28px;
  }
  .pp-time.pp-current { text-align: right; }
  .pp-scrubber {
    -webkit-appearance: none;
    appearance: none;
    flex: 1; min-width: 0;
    height: 4px;
    border-radius: 2px;
    background: linear-gradient(to right,
      var(--teal-mid) 0%, var(--teal-mid) var(--pp-progress, 0%),
      var(--void-raised) var(--pp-progress, 0%), var(--void-raised) 100%);
    outline: none;
    cursor: pointer;
  }
  .pp-scrubber::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 11px; height: 11px; border-radius: 50%;
    background: var(--mist-bright);
    cursor: pointer;
  }
  .pp-scrubber::-moz-range-thumb {
    width: 11px; height: 11px; border-radius: 50%;
    background: var(--mist-bright); border: none; cursor: pointer;
  }
  .pp-scrubber::-moz-range-track {
    height: 4px; border-radius: 2px; background: var(--void-raised);
  }
  .pp-scrubber::-moz-range-progress {
    height: 4px; border-radius: 2px; background: var(--teal-mid);
  }
  .pp-audio { display: none; }

  /* ── Session List ─────────────────────────────────────────────────── */
  .session-list { list-style: none; }
  .session-entry {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 1.5rem;
    margin: 0 -1.25rem;
    padding: 1.75rem 1.25rem;
    border-radius: 2px;
    border-bottom: 1px solid var(--border-default);
    text-decoration: none;
    transition: background 0.15s;
  }
  .session-entry:first-child { border-top: 1px solid var(--border-default); }
  .session-entry:hover { background: var(--void-raised); }
  .session-entry:hover .se-title { color: var(--mist-bright); }
  .session-entry.latest {
    background: rgba(104,152,168,0.07);
    border-left: 2px solid var(--teal-bright);
  }
  .session-entry.latest:hover { background: rgba(104,152,168,0.11); }
  .session-entry.latest:first-child { border-top: none; }
  .session-entry.latest .se-title { color: var(--mist-bright); }

  .se-num-col { text-align: right; padding-top: 3px; }
  .se-num {
    font-family: "Cinzel Decorative", serif; font-size: 22px;
    color: var(--teal-deep); line-height: 1; display: block;
    transition: font-size 0.2s, color 0.2s;
  }
  .session-entry.latest .se-num {
    font-size: 30px;
    color: var(--teal-bright);
  }
  .se-num-label {
    font-family: "Cinzel", serif; font-size: 8px;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--text-dim); display: block; margin-top: 0.15rem;
  }

  .se-header {
    display: flex; align-items: baseline;
    justify-content: space-between; gap: 1rem; margin-bottom: 0.3rem;
  }
  .se-title-group {
    display: flex; align-items: baseline;
    gap: 0.6rem; flex-wrap: wrap;
  }
  .se-title {
    font-family: "Cinzel", serif; font-size: 15px; font-weight: 600;
    color: var(--mist-mid); letter-spacing: 0.04em; transition: color 0.2s;
  }
  .se-date {
    font-family: "Cinzel", serif; font-size: 9px;
    letter-spacing: 0.1em; color: var(--text-dim);
    white-space: nowrap; flex-shrink: 0;
  }
  .se-desc {
    font-style: italic; font-size: 15px;
    color: var(--text-muted); line-height: 1.65; margin-bottom: 0.6rem;
  }
  .se-footer {
    display: flex; align-items: center;
    gap: 0.5rem; flex-wrap: wrap;
  }
  .se-tag {
    font-family: "Cinzel", serif; font-size: 8px;
    letter-spacing: 0.12em; text-transform: uppercase;
    padding: 0.15rem 0.45rem; border-radius: 2px;
    border: 1px solid var(--border-default); color: var(--text-dim);
  }
  .se-tag.highlight {
    border-color: var(--border-accent); color: var(--teal-mid);
    background: rgba(104,152,168,0.06);
  }
  .se-meta {
    font-family: "Cinzel", serif; font-size: 9px;
    letter-spacing: 0.08em; color: var(--text-dim); margin-left: auto;
  }

  /* ── Empty State ──────────────────────────────────────────────────── */
  .empty-state {
    padding: 4rem 2rem; text-align: center;
    border: 1px solid var(--border-default); background: var(--void-surface);
  }
  .empty-state i { font-size: 2rem; color: var(--teal-deep); margin-bottom: 1rem; display: block; }
  .empty-state p { font-style: italic; color: var(--text-dim); }

  /* ── Responsive ───────────────────────────────────────────────────── */
  @media (max-width: 900px) {
    .page-header-inner { flex-direction: column; align-items: flex-start; }
    .chronicles-layout { grid-template-columns: 1fr; }
    .session-list-col { max-width: none; }
    .podcast-sidebar { position: static; }
  }
  @media (max-width: 600px) {
    .stat-strip-inner { flex-wrap: wrap; gap: 1.25rem 0; padding: 1rem 1.5rem; }
    .strip-stat { flex: 1 1 33%; border-right: none; }
    .se-header { flex-direction: column; gap: 0.15rem; }
  }
</style>

<script>
  function fmtTime(seconds: number): string {
    if (!Number.isFinite(seconds)) return '0:00';
    const m = Math.floor(seconds / 60);
    const s = Math.floor(seconds % 60);
    return `${m}:${String(s).padStart(2, '0')}`;
  }

  const player = document.getElementById('playlist-player');
  const audio = player?.querySelector<HTMLAudioElement>('.pp-audio');
  const toggle = player?.querySelector<HTMLButtonElement>('.pp-toggle');
  const toggleIcon = toggle?.querySelector('i');
  const scrubber = player?.querySelector<HTMLInputElement>('.pp-scrubber');
  const currentEl = player?.querySelector<HTMLSpanElement>('.pp-current');
  const durationEl = player?.querySelector<HTMLSpanElement>('.pp-duration');
  const nowPlaying = document.getElementById('ps-now-playing');
  const items = Array.from(document.querySelectorAll<HTMLButtonElement>('.ps-item'));

  if (audio && toggle && toggleIcon && scrubber && currentEl && durationEl && nowPlaying && items.length > 0) {
    let activeItem: HTMLButtonElement | null = null;

    const setProgress = (current: number, duration: number) => {
      const pct = duration > 0 ? (current / duration) * 100 : 0;
      scrubber.style.setProperty('--pp-progress', `${pct}%`);
    };

    const setItemIcon = (item: HTMLButtonElement, playing: boolean) => {
      const icon = item.querySelector('.ps-play-icon');
      icon?.classList.toggle('fa-play', !playing);
      icon?.classList.toggle('fa-pause', playing);
    };

    function loadAndPlay(item: HTMLButtonElement) {
      if (activeItem) {
        activeItem.classList.remove('active');
        setItemIcon(activeItem, false);
      }
      activeItem = item;
      item.classList.add('active');
      nowPlaying!.textContent = item.dataset.title ?? '';
      nowPlaying!.classList.add('playing');
      toggle!.disabled = false;

      audio!.src = item.dataset.src ?? '';
      audio!.play();
    }

    items.forEach((item) => {
      item.addEventListener('click', () => {
        if (item === activeItem) {
          if (audio.paused) audio.play();
          else audio.pause();
        } else {
          loadAndPlay(item);
        }
      });
    });

    toggle.addEventListener('click', () => {
      if (!activeItem) return;
      if (audio.paused) audio.play();
      else audio.pause();
    });

    audio.addEventListener('play', () => {
      toggleIcon.classList.replace('fa-play', 'fa-pause');
      toggle.setAttribute('aria-label', 'Pause episode');
      if (activeItem) setItemIcon(activeItem, true);
    });

    audio.addEventListener('pause', () => {
      toggleIcon.classList.replace('fa-pause', 'fa-play');
      toggle.setAttribute('aria-label', 'Play episode');
      if (activeItem) setItemIcon(activeItem, false);
    });

    audio.addEventListener('loadedmetadata', () => {
      scrubber.max = String(audio.duration);
      durationEl.textContent = fmtTime(audio.duration);
    });

    audio.addEventListener('timeupdate', () => {
      if (document.activeElement !== scrubber) {
        scrubber.value = String(audio.currentTime);
      }
      currentEl.textContent = fmtTime(audio.currentTime);
      setProgress(audio.currentTime, audio.duration);
    });

    audio.addEventListener('ended', () => {
      if (activeItem) setItemIcon(activeItem, false);
      toggleIcon.classList.replace('fa-pause', 'fa-play');
      const currentIndex = activeItem ? items.indexOf(activeItem) : -1;
      const next = currentIndex >= 0 ? items[currentIndex + 1] : undefined;
      if (next) loadAndPlay(next);
    });

    scrubber.addEventListener('input', () => {
      const value = scrubber.valueAsNumber;
      audio.currentTime = value;
      currentEl.textContent = fmtTime(value);
      setProgress(value, audio.duration);
    });
  }
</script>
